// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "reasoning": "high"
      },
      "metis": {
        "model": "agnes/agnes-2.5-flash",
        "fallback_models": [
          "sensenova/sensenova-6.8-flash-lite",
          "discovery/Agents-A1",
          {
            "model": "opencode/glm-5.3-flash-free",
            "reasoning": "high"
          },
          "big-model/glm-4.7-flash",
          "amd/GLM-5.3-Flash"
        ]
      },
      "prometheus": {
        "model": "sensenova/deepseek-v4.1-flash",
        "reasoning": "high",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "discovery/deepseek-v4.1-flash-1017",
          {
            "model": "opencode-go/deepseek-v4.1-flash",
            "reasoning": "high"
          },
          {
            "model": "amd/DeepSeek-V4-Flash",
            "reasoning": "high"
          }
        ]
      },
      "atlas": {
        "model": "discovery/deepseek-v4-pro-0813",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "sensenova/kimi-k3",
          "opencode/big-pickle",
          {
            "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
            "reasoning": "high"
          }
        ]
      },
      "hephaestus": {
        "model": "discovery/kimi-k2.6",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          {
            "model": "sensenova/glm-5.2",
            "reasoning": "high"
          },
          {
            "model": "opencode/flint-40b-free",
            "reasoning": "xhigh"
          },
          {
            "model": "amd/Qwen3.8-Flash-Next",
            "reasoning": "xhigh"
          },
          {
            "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
            "reasoning": "high"
          }
        ]
      },
      "oracle": {
        "model": "sensenova/glm-5.2",
        "reasoning": "high",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "discovery/Sage-A1.5",
          {
            "model": "opencode/deepseek-v4.1-flash-free",
            "reasoning": "high"
          },
          {
            "model": "amd/DeepSeek-V4.1-Flash",
            "reasoning": "high"
          },
          {
            "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
            "reasoning": "high"
          }
        ]
      },
      "momus": {
        "model": "agnes/agnes-3.0-flash",
        "fallback_models": [
          "sensenova/deepseek-v4-flash",
          "discovery/minimax-m3",
          {
            "model": "opencode/glm-5.3-flash-free",
            "reasoning": "high"
          },
          "big-model/glm-4.7-flash",
          "amd/GLM-5.3-Flash"
        ]
      },
      "explore": {
        "model": "agnes/agnes-2.5-flash",
        "fallback_models": [
          "sensenova/sensenova-6.8-flash-lite",
          "discovery/Agents-A1",
          "opencode/mimo-v2.6-flash-free",
          "opencode/nemotron-3.5-lightning-free",
          "opencode-go/deepseek-v4.1-flash"
        ]
      },
      "librarian": {
        "model": "sensenova/deepseek-v4-flash",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "discovery/intern-s2",
          "opencode/beam-free",
          "opencode/deepseek-v4.1-flash-free",
          "amd/DeepSeek-V4-Flash"
        ]
      },
      "multimodal-looker": {
        "model": "agnes/agnes-3.0-flash",
        "fallback_models": [
          "sensenova/sensenova-6.8-flash-lite",
          "discovery/intern-s2",
          "discovery/Agents-A1",
          "discovery/Sage-A1.5",
          "discovery/deepseek-v4.1-flash-1017",
          "discovery/kimi-k2.6",
          "discovery/qwen3.8-27b",
          "opencode/nemotron-3.5-super-vl-free",
          "amd/MiMo-V2.6-Flash",
          {
            "model": "amd/DeepSeek-V4.1-Flash",
            "reasoning": "medium"
          },
          {
            "model": "amd/Qwen3.8-Flash-Next",
            "reasoning": "medium"
          }
        ]
      },
      "sisyphus-junior": {
        "model": "discovery/qwen3.8-27b",
        "fallback_models": [
          "agnes/agnes-2.5-flash",
          "sensenova/deepseek-v4-flash",
          "opencode/flint-40b-free",
          "opencode/nemotron-3.5-lightning-free",
          "amd/MiMo-V2.6-Flash"
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "agnes/agnes-3.0-flash",
        "fallback_models": [
          "sensenova/sensenova-6.8-flash-lite",
          "discovery/Atria-Dawn",
          "opencode/nemotron-3.5-super-vl-free",
          "amd/MiMo-V2.6-Flash"
        ]
      },
      "artistry": {
        "model": "agnes/agnes-2.5-flash",
        "fallback_models": [
          "sensenova/kimi-k3",
          "discovery/minimax-m3",
          "opencode/big-pickle",
          "amd/Qwen3.8-Flash-Next"
        ]
      },
      "ultrabrain": {
        "model": "sensenova/kimi-k3",
        "reasoning": "high",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "discovery/deepseek-v4-pro-0813",
          "discovery/glm-5.3",
          {
            "model": "opencode/deepseek-v4.1-flash-free",
            "reasoning": "max"
          },
          {
            "model": "amd/DeepSeek-V4.1-Flash",
            "reasoning": "xhigh"
          },
          {
            "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
            "reasoning": "high"
          }
        ]
      },
      "deep": {
        "model": "discovery/deepseek-v4-pro-0813",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          {
            "model": "sensenova/glm-5.2",
            "reasoning": "high"
          },
          {
            "model": "opencode/flint-40b-free",
            "reasoning": "xhigh"
          },
          {
            "model": "opencode/nemotron-3-ultra-free",
            "reasoning": "high"
          },
          {
            "model": "amd/DeepSeek-V4-Flash",
            "reasoning": "xhigh"
          },
          {
            "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
            "reasoning": "high"
          }
        ]
      },
      "quick": {
        "model": "agnes/agnes-2.5-flash",
        "fallback_models": [
          "sensenova/sensenova-6.8-flash-lite",
          "discovery/Agents-A1",
          "opencode/mimo-v2.6-flash-free",
          "opencode/nemotron-3.5-lightning-free",
          "big-model/glm-4.7-flash",
          "amd/GLM-5.3-Flash"
        ]
      },
      "unspecified-high": {
        "model": "sensenova/deepseek-v4.1-flash",
        "reasoning": "high",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "discovery/deepseek-v4.1-flash-1017",
          {
            "model": "opencode-go/deepseek-v4.1-flash",
            "reasoning": "max"
          },
          {
            "model": "opencode/deepseek-v4.1-flash-free",
            "reasoning": "high"
          },
          {
            "model": "amd/DeepSeek-V4.1-Flash",
            "reasoning": "high"
          }
        ]
      },
      "unspecified-low": {
        "model": "agnes/agnes-2.5-flash",
        "fallback_models": [
          "sensenova/deepseek-v4-flash",
          "discovery/qwen3.8-27b",
          "opencode/beam-free",
          "opencode/glm-5.3-flash-free",
          "opencode/nemotron-3.5-lightning-free"
        ]
      },
      "writing": {
        "model": "agnes/agnes-3.0-flash",
        "fallback_models": [
          "sensenova/glm-5.2",
          "discovery/Sage-A1.5",
          "opencode/big-pickle",
          "opencode/flint-40b-free",
          "amd/GLM-5.3-Flash"
        ]
      },
      "git": {
        "model": "sensenova/deepseek-v4-flash",
        "fallback_models": [
          "agnes/agnes-2.5-flash",
          "discovery/deepseek-v4.1-flash-1017",
          "opencode/deepseek-v4.1-flash-free",
          "opencode-go/deepseek-v4.1-flash",
          "amd/DeepSeek-V4-Flash"
        ]
      },
      "general": {
        "model": "discovery/glm-5.3",
        "fallback_models": [
          "agnes/agnes-3.0-flash",
          "sensenova/deepseek-v4-flash",
          "discovery/intern-s2",
          "discovery/Atria-Dawn",
          "discovery/kimi-k2.6",
          "opencode/mimo-v2.6-flash-free",
          "opencode/nemotron-3-ultra-free",
          "amd/MiMo-V2.6-Flash",
          {
            "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
            "reasoning": "medium"
          }
        ]
      }
    },
    "background_task": {
      "providerConcurrency": {
        "nvidia": 1,
        "opencode": 5,
        "opencode-go": 1,
        "sensenova": 3,
        "agnes": 3,
        "big-model": 1,
        "discovery": 8,
        "amd": 1
      },
      "modelConcurrency": {
        "sensenova/deepseek-v4-flash": 1,
        "sensenova/deepseek-v4.1-flash": 1,
        "sensenova/glm-5.2": 1,
        "sensenova/kimi-k3": 1,
        "discovery/deepseek-v4-pro-0813": 1,
        "discovery/deepseek-v4.1-flash-1017": 1,
        "discovery/glm-5.3": 1,
        "discovery/kimi-k2.6": 1,
        "discovery/minimax-m3": 1,
        "discovery/qwen3.8-27b": 1
      }
    },
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        400,
        401,
        403,
        404,
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 4,
      "cooldown_seconds": 15,
      "timeout_seconds": 12,
      "notify_on_fallback": true
    },
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true,
      "refresh_timeout_ms": 5000,
      "source_url": "https://models.dev/api.json"
    },
    "experimental": {
      "truncate_all_tool_outputs": false,
      "aggressive_truncation": false,
      "disable_omo_env": false,
      "task_system": true,
      "dynamic_context_pruning": {
        "enabled": false,
        "notification": "detailed",
        "turn_protection": {
          "enabled": true,
          "turns": 3
        },
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
          "session_search"
        ],
        "strategies": {
          "deduplication": {
            "enabled": true
          },
          "supersede_writes": {
            "enabled": true,
            "aggressive": false
          },
          "purge_errors": {
            "enabled": true,
            "turns": 5
          }
        }
      }
    },
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 60,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
    "2026-09-category-deep-split"
  ]
}