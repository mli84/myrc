    },
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        400,
        401,
        403,
        404,
        429,
        500,
        502,
        503,
        504
      ],
      "max_fallback_attempts": 4,
      "cooldown_seconds": 15,
      "timeout_seconds": 12,
      "notify_on_fallback": true
    },
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true,
      "refresh_timeout_ms": 5000,
      "source_url": "https://models.dev/api.json"
    },
    "experimental": {
      "truncate_all_tool_outputs": false,
      "aggressive_truncation": false,
      "disable_omo_env": false,
      "task_system": true,
      "dynamic_context_pruning": {
        "enabled": false,
        "notification": "detailed",
        "turn_protection": {
          "enabled": true,
          "turns": 3
        },
        "protected_tools": [
          "task",
          "todowrite",
          "todoread",
          "lsp_rename",
          "session_read",
          "session_write",
