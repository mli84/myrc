{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "opencode-antigravity-auth@latest",
    "oh-my-openagent@latest"
  ],
  "model": "nvidia/stepfun-ai/step-3.5-flash",
  "provider": {
      "longcat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LongCat",
      "options": {
        "baseURL": "https://api.longcat.chat/openai/v1",
        "headers": {
          "Authorization": "Bearer {env:LONGCAT_API_KEY}"
        }
      },
      "models": {
        "LongCat-Flash-Thinking": {
          "name": "LongCat Flash Thinking",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "LongCat-Flash-Lite": {
          "name": "LongCat Flash Lite",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        }
      }
    }
  },
  "mcp": {
    "graphify": {
      "command": [
        "python3",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true,
      "type": "local"
    },
    "XcodeBuildMCP": {
      "command": [
        "npx",
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "enabled": false,
      "type": "local"
    }
  }
}
