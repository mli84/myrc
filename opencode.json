{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "oh-my-openagent",
    "opencode-antigravity-auth@latest"
  ],
  "mcp": {
    "swiftlens": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "swiftlens"
      ]
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "xcodebuildmcp",
        "mcp"
      ],
      "enabled": false
    },
    "Figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    }
  },
  "provider": {
    "freemodel": {
      "npm": "@ai-sdk/openai",
      "name": "FreeModel",
      "options": {
        "baseURL": "https://api.freemodel.dev/v1",
        "apiKey": "{env:FREEMODEL_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:FREEMODEL_API_KEY}"
        }
      },
      "models": {
        "gpt-5.2": {
          "name": "gpt-5.2",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "gpt-5": {
          "name": "gpt-5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "gpt-5.5": {
          "name": "gpt-5.5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-haiku-4.5": {
          "name": "claude-haiku-4.5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-4.6": {
          "name": "claude-4.6",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-opus-4.7": {
          "name": "claude-opus-4.7",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-opus-4.8": {
          "name": "claude-opus-4.8",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "blazeai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BlazeAI",
      "options": {
        "baseURL": "https://blazeai.boxu.dev/api/v1",
        "headers": {
          "Authorization": "Bearer {env:BLAZE_API_KEY}"
        }
      },
      "models": {
        "deepseek-r1:70b": {
          "name": "deepseek-r1:70b",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "grok-4.1-fast": {
          "name": "grok-4.1-fast",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "grok-4.20-fast": {
          "name": "grok-4.20-fast",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.5-omni-flash-search": {
          "name": "qwen3.5-omni-flash-search",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.5-omni-flash-thinking-search": {
          "name": "qwen3.5-omni-flash-thinking-search",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.5-omni-plus-search": {
          "name": "qwen3.5-omni-plus-search",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.5-omni-plus-thinking": {
          "name": "qwen3.5-omni-plus-thinking",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.5-omni-plus-thinking-search": {
          "name": "qwen3.5-omni-plus-thinking-search",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.6-max-preview": {
          "name": "qwen3.6-max-preview",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.6-max-preview-thinking": {
          "name": "qwen3.6-max-preview-thinking",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.6-plus": {
          "name": "qwen3.6-plus",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.6-plus-search": {
          "name": "qwen3.6-plus-search",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.6-plus-thinking": {
          "name": "qwen3.6-plus-thinking",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "qwen3.6-plus-thinking-search": {
          "name": "qwen3.6-plus-thinking-search",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "z-ai/glm-5.1": {
          "name": "glm-5.1",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "longcat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LongCat",
      "options": {
        "baseURL": "https://api.longcat.chat/openai/v1",
        "headers": {
          "Authorization": "Bearer {env:LONGCAT_API_KEY}"
        }
      },
      "models": {
        "LongCat-2.0-Preview": {
          "name": "LongCat 2.0 Preview",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}