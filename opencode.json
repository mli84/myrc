{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth@latest",
    "oh-my-openagent",
    "opencode-antigravity-auth@latest"
  ],
  "lsp": true,
  "compaction": {
    "auto": true
  },
  "mcp": {
    "swiftlens": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "swiftlens"
      ]
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "xcodebuildmcp",
        "mcp"
      ],
      "enabled": false
    },
    "Figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    }
  },
  "provider": {
    "sensenova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sense Nova",
      "options": {
        "baseURL": "https://token.sensenova.cn/v1",
        "apiKey": "{env:SENSENOVA_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:SENSENOVA_API_KEY}"
        }
      },
      "models": {
        "sensenova-6.7-flash-lite": {
          "name": "Sense Nova sensenova-6.7-flash-lite",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "deepseek-v4-flash": {
          "name": "Sense Nova deepseek-v4-flash",
          "stream": true,
          "variants": {
            "low": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "low"
            },
            "medium": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "medium"
            },
            "high": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "high"
            },
            "none": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "none"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "cline": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cline",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:CLINE_API_KEY}"
        }
      },
      "models": {
        "xiaomi/mimo-v2.5": {
          "name": "Cline mimo-v2.5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "Cline deepseek-v4-flash",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "agnes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agnes",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:AGNES_API_KEY}"
        }
      },
      "models": {
        "agnes-1.5-flash": {
          "name": "agnes-1.5-flash",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "agnes-2.0-flash": {
          "name": "agnes-2.0-flash",
          "stream": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "stream": true,
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"],
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "opencode2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode2",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:OPENCODE_API_KEY}"
        }
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "OpenCode2 deepseek-v4-flash-free",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "freemodel": {
      "npm": "@ai-sdk/openai",
      "name": "FreeModel",
      "options": {
        "baseURL": "https://api.freemodel.dev/v1",
        "apiKey": "{env:FREEMODEL_API_KEY}",
        "headers": {
          "Authorization": "Bearer {env:FREEMODEL_API_KEY}"
        }
      },
      "models": {
        "gpt-5.2": {
          "name": "FreeModel gpt-5.2",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "gpt-5": {
          "name": "FreeModel gpt-5",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "gpt-5.5": {
          "name": "FreeModel gpt-5.5",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-haiku-4.5": {
          "name": "FreeModel claude-haiku-4.5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-4.6": {
          "name": "FreeModel claude-4.6",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-opus-4.7": {
          "name": "FreeModel claude-opus-4.7",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "claude-opus-4.8": {
          "name": "FreeModel claude-opus-4.8",
          "variants": {
            "low": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "low"
            },
            "medium": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "medium"
            },
            "high": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "high"
            },
            "max": {
            "textVerbosity": "low",
            "reasoningSummary": "auto",
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "blazeai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BlazeAI",
      "options": {
        "baseURL": "https://blazeai.boxu.dev/api/v1",
        "headers": {
          "Authorization": "Bearer {env:BLAZE_API_KEY}"
        }
      },
      "models": {
        "grok-4.20-fast": {
          "name": "grok-4.20-fast",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Blaze kimi-k2.6",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "longcat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LongCat",
      "options": {
        "baseURL": "https://api.longcat.chat/openai/v1",
        "headers": {
          "Authorization": "Bearer {env:LONGCAT_API_KEY}"
        }
      },
      "models": {
        "LongCat-2.0-Preview": {
          "name": "LongCat 2.0 Preview",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}