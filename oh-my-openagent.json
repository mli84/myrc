{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "high"
        }
      ],
      "prompt_append": "Break tasks into minimal executable steps. Use hierarchical search: module -> file -> symbol. Minimize file reads and token usage."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Optimize cost and latency aggressively. Parallelize Atlas and Explore. Prefer cheaper models first. Stop exploration early when sufficient context is gathered."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        },
        "opencode/gemini-3-flash"
      ],
      "prompt_append": "Return only relevant snippets/functions/classes. Never summarize full files. Keep output minimal and structured."
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "low"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "high"
        }
      ],
      "prompt_append": "Use Atlas results first. Expand only when necessary. Focus on dependencies, call chains, architecture, and state flow."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "low"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Avoid touching more than 2-3 files unless absolutely required. Delegate small tasks to sisyphus-junior."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid refactors. Prefer minimal diffs."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        }
      ]
    },
    "momus": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "low"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        },
        "longcat/LongCat-Flash-Thinking"
      ],
      "prompt_append": "Strictly validate correctness, regressions, edge cases, concurrency issues, and side effects. Reject uncertain fixes."
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        },
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free"
      ]
    },
    "multimodal-looker": {
      "model": "opencode/hy3-preview-free(high)",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "high"
        },
        "opencode/gemini-3-flash"
      ]
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultrabrain": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    },
    "visual-engineering": {
      "model": "nvidia/stepfun-ai/step-3.5-flash(high)"
    },
    "artistry": {
      "model": "opencode/hy3-preview-free(high)"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 1,
      "openroute": 2,
      "nvidia": 5,
      "opencode": 12,
      "longcat": 20
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 15,
      "kimi-for-coding/k2p6": 1,
      "opencode/gemini-3-flash": 1,
      "nvidia/deepseek-ai/deepseek-v4-pro": 1,
      "nvidia/qwen/qwen3-next-80b-a3b-instruct": 2
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}