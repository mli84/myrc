{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
        "model": "nvidia/openai/gpt-oss-120b",
        "variant": "high"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
        "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "variant": "high"
        },
        {
        "model": "opencode/nemotron-3-super-free",
        "variant": "high"
        },
        {
        "model": "opencode/hy3-preview-free",
        "variant": "high"
        }
      ],
      "prompt_append": "Break tasks into minimal steps. Use hierarchical exploration: module -> file -> function. Optimize for minimal context and token usage."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
        "model": "opencode/ring-2.6-1t-free",
        "variant": "low"
        },
        {
        "model": "nvidia/stepfun-ai/step-3.5-flash",
        "variant": "low"
        }
      ],
      "prompt_append": "Aggressively parallelize Atlas and Explore. Prefer cheaper models first. Stop redundant exploration early."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
        "model": "opencode/deepseek-v4-flash-free",
        "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
        "model": "nvidia/stepfun-ai/step-3.5-flash",
        "variant": "low"
        },
        {
        "model": "opencode/ring-2.6-1t-free",
        "variant": "low"
        },
        {
        "model": "opencode/hy3-preview-free",
        "variant": "low"
        }
      ],
      "prompt_append": "Return only minimal relevant snippets/functions/classes. Avoid full-file summaries. Keep outputs structured and concise."
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
        "model": "opencode/deepseek-v4-flash-free",
        "variant": "medium"
        },
        {
        "model": "nvidia/stepfun-ai/step-3.5-flash",
        "variant": "medium"
        },
        {
        "model": "opencode/ring-2.6-1t-free",
        "variant": "medium"
        },
        {
        "model": "nvidia/openai/gpt-oss-120b",
        "variant": "medium"
        }
      ],
      "prompt_append": "Use Atlas results first. Expand only when necessary. Focus on call chains, dependencies, architecture, and state flow."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        {
        "model": "nvidia/openai/gpt-oss-120b",
        "variant": "high"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
        "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "variant": "medium"
        },
        {
        "model": "opencode/nemotron-3-super-free",
        "variant": "medium"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Avoid touching more than 2-3 files unless required. Delegate trivial edits to sisyphus-junior."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
        "model": "opencode/deepseek-v4-flash-free",
        "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
        "model": "nvidia/stepfun-ai/step-3.5-flash",
        "variant": "low"
        },
        {
        "model": "opencode/ring-2.6-1t-free",
        "variant": "low"
        }
      ],
      "prompt_append": "Handle only localized edits. Avoid large refactors. Keep diffs minimal."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        {
        "model": "nvidia/openai/gpt-oss-120b",
        "variant": "high"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro",
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
        "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "variant": "high"
        },
        {
        "model": "opencode/nemotron-3-super-free",
        "variant": "high"
        },
        {
        "model": "opencode/hy3-preview-free",
        "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        "longcat/LongCat-Flash-Thinking",
        {
        "model": "opencode/deepseek-v4-flash-free",
        "variant": "medium"
        },
        {
        "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "variant": "medium"
        },
        {
        "model": "opencode/hy3-preview-free",
        "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, edge cases, regressions, race conditions, side effects, and hidden architectural risks."
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        {
        "model": "nvidia/openai/gpt-oss-120b",
        "variant": "high"
        },
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
        "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "variant": "high"
        },
        {
        "model": "opencode/nemotron-3-super-free",
        "variant": "high"
        },
        {
        "model": "opencode/hy3-preview-free",
        "variant": "high"
        },
        "opencode/gemini-3-flash"
      ]
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free",
        {
        "model": "opencode/ring-2.6-1t-free",
        "variant": "low"
        }
      ]
    },
    "multimodal-looker": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
        "model": "opencode/deepseek-v4-flash-free",
        "variant": "medium"
        },
        {
        "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
        "variant": "medium"
        }
      ],
      "prompt_append": "Focus on visual debugging, UI hierarchy, screenshots, design consistency, and multimodal reasoning."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultrabrain": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    },
    "visual-engineering": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium"
    },
    "artistry": {
      "model": "opencode/hy3-preview-free",
      "variant": "high"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 1,
      "openroute": 2,
      "nvidia": 5,
      "opencode": 12,
      "longcat": 20
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 15,
      "kimi-for-coding/k2p6": 1,
      "nvidia/openai/gpt-oss-120b": 2,
      "nvidia/deepseek-ai/deepseek-v4-pro": 2,
      "opencode/deepseek-v4-flash-free": 6,
      "opencode/ring-2.6-1t-free": 6
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}