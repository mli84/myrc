{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "nvidia/zai-org/glm-4.7",
        "nvidia/minimaxai/minimax-m2.7"
      ],
      "prompt_append": "Break tasks into minimal steps. Use hierarchical search: module -> file -> function. Optimize for minimal file reads and token usage."
    },

    "atlas": {
      "model": "nvidia/moonshotai/kimi-k2-instruct",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        "opencode/gemini-3-flash"
      ],
      "prompt_append": "Return only relevant snippets/functions/classes. Never summarize full files. Keep output minimal and structured."
    },

    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "low"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        "nvidia/zai-org/glm-4.7",
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Use Atlas results as primary context. Expand only when necessary. Focus on dependencies, call chains, state flow, architecture, and data flow."
    },

    "hephaestus": {
      "model": "nvidia/zai-org/glm-4.7",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "low"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Avoid touching more than 2-3 files unless necessary. Delegate small changes to sisyphus-junior."
    },

    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid refactors. Prefer minimal diffs. Do not expand context unnecessarily."
    },

    "sisyphus": {
      "model": "nvidia/zai-org/glm-4.7",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },

    "momus": {
      "model": "nvidia/minimaxai/minimax-m2.7",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, edge cases, side effects, race conditions, and architectural consistency. Reject uncertain fixes."
    },

    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free"
      ]
    },

    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },

    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Parallelize Atlas and Explore aggressively. Prefer cheap models first. Stop exploration early when enough context is available. Avoid duplicate calls."
    }
  },

  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },

    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },

    "mid": {
      "model": "longcat/LongCat-Flash-Thinking"
    },

    "unspecified-high": {
      "model": "nvidia/zai-org/glm-4.7"
    },

    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },

    "ultra": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    },

    "free-heavy": {
      "model": "opencode/nemotron-3-super-free",
      "variant": "high"
    },

    "free-fast": {
      "model": "opencode/hy3-preview-free",
      "variant": "medium"
    }
  },

  "background_task": {
    "providerConcurrency": {
      "longcat": 20,
      "nvidia": 6,
      "opencode": 12,
      "openroute": 2,
      "kimi-for-coding": 2
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 12,
      "kimi-for-coding/k2p6": 2,
      "nvidia/deepseek-ai/deepseek-v4-pro": 2,
      "nvidia/qwen/qwen3-next-80b-a3b-instruct": 2,
      "opencode/gemini-3-flash": 1
    }
  },

  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },

  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },

  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}