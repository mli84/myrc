{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "kimi-for-coding/k2p6",
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Break tasks into minimal executable steps. Prefer hierarchical search: module -> file -> symbol. Minimize total exploration cost and token usage."
    },
    "atlas": {
      "model": "nvidia/moonshotai/kimi-k2-instruct",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        "opencode/gemini-3-flash"
      ],
      "prompt_append": "Return only the most relevant snippets/functions/classes. Never summarize full files. Prefer minimal structured outputs."
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "low"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Use Atlas results first. Expand context only when necessary. Focus on dependencies, call chains, lifecycle flow, architecture, and state propagation."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "low"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Delegate trivial edits to sisyphus-junior. Avoid broad refactors unless explicitly required."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        "opencode/gemini-3-flash"
      ],
      "prompt_append": "Handle only small localized edits. Avoid refactors. Prefer minimal diffs. Do not expand exploration scope."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        "nvidia/minimaxai/minimax-m2.7",
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "low"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, race conditions, architectural consistency, and edge cases. Reject uncertain fixes."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ]
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Aggressively parallelize Atlas and Explore. Prefer cheap models first. Stop exploration early when confidence is sufficient. Avoid redundant calls."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "mid": {
      "model": "longcat/LongCat-Flash-Thinking"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultra": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    },
    "free-emergency": {
      "model": "opencode/nemotron-3-super-free",
      "variant": "medium"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "longcat": 20,
      "nvidia": 6,
      "opencode": 12,
      "openroute": 2,
      "kimi-for-coding": 4
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 12,
      "kimi-for-coding/k2p6": 3,
      "nvidia/deepseek-ai/deepseek-v4-pro": 2,
      "nvidia/qwen/qwen3-next-80b-a3b-instruct": 2,
      "opencode/gemini-3-flash": 1
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}