{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/openai/gpt-oss-120b",
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "high"
        }
      ],
      "prompt_append": "Break tasks into minimal steps. Use hierarchical search: module -> file -> function. Optimize for minimal token usage."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        },
        {
          "model": "opencode/deepSeek-v4-flash-free",
          "variant": "low"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        }
      ],
      "prompt_append": "Return only relevant snippets/functions/classes. Never summarize entire files."
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "opencode/deepSeek-v4-flash-free",
          "variant": "medium"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        }
      ],
      "prompt_append": "Use Atlas results first. Expand only when necessary. Focus on architecture, dependencies, and call chains."
    },
    "hephaestus": {
      "model": "nvidia/openai/gpt-oss-120b",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        "kimi-for-coding/k2p6",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Delegate trivial edits to sisyphus-junior."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/gemini-3-flash"
      ],
      "prompt_append": "Handle only small localized edits. Avoid refactors. Prefer minimal diffs."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/openai/gpt-oss-120b",
        "nvidia/minimaxai/minimax-m2.7",
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        }
      ]
    },
    "momus": {
      "model": "nvidia/openai/gpt-oss-120b",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "opencode/deepSeek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, edge cases, regressions, race conditions, and side effects."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        }
      ]
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        },
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        }
      ]
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Parallelize Atlas and Explore aggressively. Prefer cheap providers first. Stop exploration early when enough context exists."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "mid": {
      "model": "longcat/LongCat-Flash-Thinking"
    },
    "unspecified-high": {
      "model": "nvidia/openai/gpt-oss-120b"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultra": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "longcat": 30,
      "opencode": 20,
      "nvidia": 8,
      "openroute": 1,
      "kimi-for-coding": 1
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 50,
      "longcat/LongCat-Flash-Thinking": 20,
      "opencode/minimax-m2.5-free": 15,
      "nvidia/openai/gpt-oss-120b": 4,
      "nvidia/deepseek-ai/deepseek-v4-pro": 2,
      "kimi-for-coding/k2p6": 1,
      "opencode/gemini-3-flash": 1
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}