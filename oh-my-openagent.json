{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "nvidia/moonshotai/kimi-k2-instruct",
        "longcat/LongCat-Flash-Thinking"
      ]
    },
    "librarian": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ]
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ]
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "kimi-for-coding/k2p6"
      ]
    },
    "hephaestus": {
      "model": "opencode/minimax-m2.5-free",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite"
      ]
    },
    "prometheus": {
      "model": "kimi-for-coding/k2p5",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "longcat/LongCat-Flash-Thinking"
      ],
      "prompt_append": "Break tasks into minimal independent steps. Maximize parallel execution using explore and librarian. Avoid over-calling oracle unless necessary."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "writing": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultrabrain": {
      "model": "nvidia/nemotron-3-super-120b-a12b",
      "variant": "high"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "nvidia": 3,
      "kimi-for-coding": 3,
      "longcat": 10,
      "opencode": 10
    },
    "modelConcurrency": {
      "k2p6": 2,
      "LongCat-Flash-Lite": 20
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}
