{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/qwen/qwen3.5-122b-a10b",
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        }
      ]
    },
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/qwen/qwen3.5-122b-a10b",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        "longcat/LongCat-2.0-Preview"
      ],
      "prompt_append": "Break tasks into minimal steps. Use hierarchical search: module -> file -> function. Minimize file reads and token usage."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Parallelize Atlas and Explore aggressively. Prefer cheaper models first. Stop exploration early when sufficient context is available."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        },
        "opencode/gemini-3-flash",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Return only relevant snippets, functions, and classes. Avoid full file summaries. Keep output structured and minimal."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/qwen/qwen3.5-122b-a10b",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        "longcat/LongCat-2.0-Preview"
      ],
      "prompt_append": "Prefer localized fixes. Minimize changes. Avoid touching more than 2-3 files unless absolutely necessary. Delegate small changes to Sisyphus-Junior."
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        "longcat/LongCat-2.0-Preview",
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, edge cases, regressions, and side effects. Reject uncertain fixes."
    },
    "explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "high"
        }
      ],
      "prompt_append": "Use Atlas results as primary context. Expand only when necessary. Focus on architecture, dependencies, and call chains."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free"
      ]
    },
    "multimodal-Looker": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "max"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ]
    },
    "sisyphus-Junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid refactors. Prefer minimal diffs and minimal context expansion."
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "artistry": {
      "model": "opencode/hy3-preview-free",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    },
    "git": {
      "model": "longcat/LongCat-Flash-Thinking"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "nvidia": 3,
      "opencode": 8,
      "longcat": 16
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "kimi-for-coding/k2p6": 1,
      "nvidia/qwen/qwen3-next-80b-a3b-instruct": 2,
      "nvidia/qwen/qwen3.5-122b-a10b": 2,
      "opencode/deepseek-v4-flash-free": 8
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}