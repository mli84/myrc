{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-pro",
        "kimi-for-coding/k2p6"
      ],
      "prompt_append": "Break tasks into minimal steps. Prefer module→file→function search. Minimize total file reads. Guide Atlas and Explore precisely."
    },
    "atlas": {
      "model": "nvidia/moonshotai/kimi-k2-instruct",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free"
      ],
      "prompt_append": "Return only relevant code snippets (functions/classes). No full file summaries. Keep output minimal and structured."
    },
    "explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        "longcat/LongCat-Flash-Thinking",
        "nvidia/deepseek-ai/deepseek-v4-flash"
      ],
      "prompt_append": "Use Atlas results as primary context. Expand only if necessary. Focus on call chains, dependencies, and data flow."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "kimi-for-coding/k2p5"
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Avoid touching more than 2-3 files unless required. Ensure backward compatibility."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "nvidia/minimaxai/minimax-m2.7",
        "kimi-for-coding/k2p5"
      ]
    },
    "momus": {
      "model": "kimi-for-coding/k2p5",
      "fallback_models": [
        "longcat/LongCat-2.0-Preview",
        "nvidia/zai-org/glm-4.7"
      ],
      "prompt_append": "Strictly validate correctness, edge cases, side effects. Reject uncertain results and request deeper analysis if needed."
    },
    "librarian": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ]
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "nvidia/qwen/qwen3-next-80b-a3b-instruct"
      ]
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ],
      "prompt_append": "Parallelize Atlas and Explore. Prefer cheap models first. Stop exploration early when context is sufficient. Avoid redundant calls."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free"
      ],
      "prompt_append": "Handle small, localized code changes only. Do not perform large refactors. Avoid modifying multiple files. Prefer minimal edits."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "mid": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultra": {
      "model": "nvidia/nemotron-3-super-120b-a12b",
      "variant": "high"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "longcat": 30,
      "opencode": 3,
      "kimi-for-coding": 5,
      "nvidia": 10
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 20,
      "longcat/LongCat-2.0-Preview": 20,
      "kimi-for-coding/k2p6": 3
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}