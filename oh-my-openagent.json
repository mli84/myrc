{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-pro",
        "nvidia/moonshotai/kimi-k2.6",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "kimi-for-coding/k2p6",
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Break tasks into minimal precise steps. Prefer hierarchical search: module -> file -> symbol. Optimize for minimal token usage and minimal file reads."
    },
    "atlas": {
      "model": "nvidia/moonshotai/kimi-k2-instruct",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "nvidia/minimaxai/minimax-m2.7",
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Return only relevant functions/classes/snippets. Never summarize entire files. Keep output compact and structured."
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        "nvidia/moonshotai/kimi-k2.6",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        "nvidia/zai-org/glm-4.7",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Use Atlas results as primary context. Expand only when necessary. Focus on architecture, dependencies, state flow, and call chains."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "kimi-for-coding/k2p5",
        "nvidia/moonshotai/kimi-k2.6",
        "nvidia/minimaxai/minimax-m2.7",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "high"
        }
      ],
      "prompt_append": "Minimize modifications. Prefer localized fixes. Avoid touching more than 2-3 files unless absolutely necessary. Delegate trivial edits to sisyphus-junior."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid refactors. Avoid unrelated file reads. Prefer minimal diffs."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "kimi-for-coding/k2p5",
        "nvidia/moonshotai/kimi-k2.6",
        "nvidia/minimaxai/minimax-m2.7",
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ]
    },
    "momus": {
      "model": "kimi-for-coding/k2p5",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "longcat/LongCat-Flash-Thinking",
        "nvidia/moonshotai/kimi-k2.6",
        "nvidia/deepseek-ai/deepseek-v4-flash",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, race conditions, edge cases, and side effects. Reject uncertain solutions."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ]
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        "nvidia/moonshotai/kimi-k2.6",
        {
          "model": "openroute/nvidia/nemotron-3-super-120b-a12b:free"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        "opencode/minimax-m2.5-free",
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Aggressively parallelize Atlas and Explore. Prefer cheaper models first. Stop exploration early when sufficient context is collected. Avoid duplicate calls."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "mid": {
      "model": "longcat/LongCat-Flash-Thinking"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultra": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    },
    "experimental": {
      "model": "nvidia/moonshotai/kimi-k2.6"
    },
    "free-tier": {
      "model": "opencode/minimax-m2.5-free"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "longcat": 50,
      "kimi-for-coding": 5,
      "nvidia": 20,
      "opencode": 10,
      "openroute": 2
    },
    "modelConcurrency": {
      "kimi-for-coding/k2p6": 3,
      "opencode/gemini-3-flash": 1
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}