      "model": "blazeai/qwen3.5-omni-plus-thinking"
    },
    "artistry": {
      "model": "blazeai/grok-4.1-fast"
    },
    "ultrabrain": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "variant": "max"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "writing": {
      "model": "opencode/gemini-3.5-flash",
      "variant": "medium"
    },
    "git": {
      "model": "longcat/LongCat-Flash-Thinking"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 2,
      "blazeai": 4,
      "nvidia": 6,
      "opencode": 10,
      "longcat": 16
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "kimi-for-coding/k2p6": 2,
      "nvidia/deepseek-ai/deepseek-v4-pro": 2,
      "opencode/gemini-3.5-flash": 4
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}