{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "longcat/LongCat-2.0-Preview",
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ]
    },
    "metis": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ],
      "prompt_append": "Break tasks into minimal steps. Prefer hierarchical exploration from module to file to function. Optimize for minimal context usage."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        },
        {
          "model": "opencode/big-pickle"
        }
      ],
      "prompt_append": "Parallelize atlas and explore aggressively. Prefer cheaper models first. Stop exploration early when enough context is available."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Return only relevant snippets, functions, and classes. Avoid full file summaries. Keep output concise and structured."
    },
    "hephaestus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ],
      "prompt_append": "Minimize code modifications. Prefer localized fixes. Delegate trivial edits to sisyphus-junior."
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-2.0-Preview",
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, edge cases, concurrency issues, and side effects. Reject uncertain fixes."
    },
    "explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "high"
        }
      ],
      "prompt_append": "Use atlas output as primary context. Expand only when necessary. Focus on dependencies, architecture, state flow, and call chains."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "opencode/qwen3.6-plus-free"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ]
    },
    "multimodal-looker": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "low"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "max"
        },
        {
          "model": "opencode/big-pickle"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid large refactors and unrelated file modifications."
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        }
      ]
    },
    "artistry": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "opencode/big-pickle"
        }
      ]
    },
    "ultrabrain": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
      "variant": "high",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        }
      ]
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ]
    },
    "unspecified-high": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        "kimi-for-coding/k2p6",
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        }
      ]
    },
    "unspecified-low": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        }
      ]
    },
    "writing": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Thinking",
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "git": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "low"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        }
      ]
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 2,
      "nvidia": 4,
      "opencode": 8,
      "longcat": 16
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 20,
      "longcat/LongCat-2.0-Preview": 8,
      "kimi-for-coding/k2p6": 2,
      "opencode/gemini-3-flash": 1
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}