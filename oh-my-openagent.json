{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "nvidia/moonshotai/kimi-k2-instruct",
        "longcat/LongCat-Flash-Thinking"
      ]
    },
    "librarian": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free"
      ]
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/moonshotai/kimi-k2-instruct",
        "opencode/minimax-m2.5-free"
       ],
       "prompt_append": "Use Atlas results as primary context. Expand only when necessary. Focus on code relationships, call chains, and dependencies. Avoid re-reading entire files unless required."
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "kimi-for-coding/k2p6"
      ]
    },
    "hephaestus": {
      "model": "opencode/minimax-m2.5-free",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite"
      ]
    },
    "prometheus": {
      "model": "kimi-for-coding/k2p5",
      "fallback_models": [
        "nvidia/zai-org/glm-4.7",
        "longcat/LongCat-Flash-Thinking"
      ],
      "prompt_append": "Break tasks into minimal independent steps. Maximize parallel execution using explore and librarian. Avoid over-calling oracle unless necessary."
    },
    "atlas": {
      "model": "nvidia/moonshotai/kimi-k2-instruct",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free"
       ],
      "prompt_append": "You are a code retrieval engine. Return only the most relevant code snippets. Do NOT summarize entire files. Prefer exact functions, classes, and definitions. Keep output minimal and structured."
    },
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
         "kimi-for-coding/k2p6",
          {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
          }
        ],
      "prompt_append": "You are a planning and decomposition engine for large codebases. Break tasks into minimal, precise steps. Optimize for minimal file reads. Guide Atlas for retrieval and Explore for deep analysis. Avoid redundant exploration."
    },
    "momus": {
      "model": "nvidia/moonshotai/kimi-k2.5",
      "fallback_models": [
            "nvidia/zai-org/glm-4.7",
            "longcat/LongCat-Flash-Thinking"
          ],
      "prompt_append": "You are a strict code reviewer and validator. Verify correctness, completeness, and side effects. Detect missing edge cases and incorrect assumptions. If issues are found, suggest revisiting Metis planning or Explore analysis."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "unspecified-high": {
      "model": "kimi-for-coding/k2p6"
    },
    "writing": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultrabrain": {
      "model": "nvidia/nemotron-3-super-120b-a12b",
      "variant": "high"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 3,
      "nvidia": 10,
      "longcat": 15,
      "opencode": 10
    },
    "modelConcurrency": {
      "k2p6": 2,
      "LongCat-Flash-Thinking": 10,
      "LongCat-Flash-Lite": 30
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}
