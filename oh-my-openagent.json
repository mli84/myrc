{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "metis": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        "nvidia/openai/gpt-oss-120b",
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "opencode/nemotron-3-super-free"
      ],
      "prompt_append": "Break tasks into minimal executable steps. Use hierarchical search: module -> file -> function. Minimize file reads and token usage."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "opencode/minimax-m2.5-free",
        "opencode/hy3-preview-free"
      ],
      "prompt_append": "Parallelize Atlas and Explore aggressively. Prefer cheap models first. Stop exploration early when context is sufficient."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        "opencode/deepSeek-v4-flash-free",
        "opencode/gemini-3-flash",
        "opencode/minimax-m2.5-free"
      ],
      "prompt_append": "Return only relevant snippets/functions/classes. Never summarize full files. Keep output minimal and structured."
    },
    "explore": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        "nvidia/stepfun-ai/step-3.5-flash",
        "opencode/deepSeek-v4-flash-free",
        "opencode/ring-2.6-1t-free"
      ],
      "prompt_append": "Use Atlas results first. Expand only when necessary. Focus on dependencies, architecture, state flow, and call chains."
    },
    "hephaestus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        "nvidia/openai/gpt-oss-120b",
        "opencode/hy3-preview-free"
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes. Avoid touching more than 2-3 files unless necessary. Delegate small changes to sisyphus-junior."
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        "opencode/ring-2.6-1t-free",
        "opencode/minimax-m2.5-free",
        "opencode/hy3-preview-free"
      ],
      "prompt_append": "Handle only localized edits. Avoid refactors. Prefer minimal diffs. Do not expand context unnecessarily."
    },
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        "nvidia/minimaxai/minimax-m2.7",
        "nvidia/openai/gpt-oss-120b",
        "nvidia/deepseek-ai/deepseek-v4-pro",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        "openroute/nvidia/nemotron-3-super-120b-a12b:free"
      ]
    },
    "momus": {
      "model": "nvidia/openai/gpt-oss-120b",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        "longcat/LongCat-Flash-Thinking",
        "opencode/nemotron-3-super-free"
      ],
      "prompt_append": "Strictly validate correctness, edge cases, regressions, race conditions, side effects, and architectural consistency."
    },
    "oracle": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "fallback_models": [
        "nvidia/qwen/qwen3-next-80b-a3b-instruct",
        {
          "model": "nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        "nvidia/openai/gpt-oss-120b",
        "openroute/nvidia/nemotron-3-super-120b-a12b:free"
      ]
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        "longcat/LongCat-Flash-Lite",
        "opencode/minimax-m2.5-free",
        "opencode/ring-2.6-1t-free"
      ]
    },
    "multimodal-looker": {
      "model": "nvidia/openai/gpt-oss-120b",
      "fallback_models": [
        "nvidia/deepseek-ai/deepseek-v4-flash",
        "opencode/hy3-preview-free"
      ],
      "prompt_append": "Focus on screenshots, UI structure, diagrams, visual bugs, and image-based debugging."
    }
  },
  "categories": {
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "unspecified-high": {
      "model": "longcat/LongCat-Flash-Thinking"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
    },
    "ultrabrain": {
      "model": "nvidia/deepseek-ai/deepseek-v4-pro"
    },
    "artistry": {
      "model": "opencode/hy3-preview-free"
    },
    "visual-engineering": {
      "model": "nvidia/openai/gpt-oss-120b"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 1,
      "openroute": 1,
      "nvidia": 5,
      "opencode": 12,
      "longcat": 20
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 12,
      "kimi-for-coding/k2p6": 1,
      "nvidia/deepseek-ai/deepseek-v4-pro": 1,
      "nvidia/openai/gpt-oss-120b": 1,
      "nvidia/qwen/qwen3-next-80b-a3b-instruct": 1,
      "opencode/gemini-3-flash": 1
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}