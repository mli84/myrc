{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "kimi-for-coding/k2p6"
        },
        {
          "model": "opencode/grok-code-fast-1"
        },
        {
          "model": "opencode/glm-4.7"
        },
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        }
      ]
    },
    "metis": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ],
      "prompt_append": "Break tasks into minimal executable steps. Prefer module to file to function exploration order. Minimize redundant reads."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Optimize for latency and token efficiency. Parallelize atlas and explore when useful. Prefer cheap models before expensive fallbacks."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/big-pickle"
        },
        {
          "model": "opencode/gemini-3-flash"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ],
      "prompt_append": "Return only highly relevant snippets, functions, symbols, and file paths. Avoid full file summaries."
    },
    "hephaestus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "kimi-for-coding/k2p6"
        },
        {
          "model": "opencode/grok-code-fast-1"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        }
      ],
      "prompt_append": "Minimize code modifications. Prefer localized edits. Delegate trivial changes to sisyphus-junior."
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "opencode/glm-4.7"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "low"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, edge cases, and side effects. Reject uncertain fixes."
    },
    "explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Thinking"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Use atlas output as primary context. Expand only when necessary. Focus on dependencies, architecture, and call chains."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "multimodal-looker": {
      "model": "opencode/hy3-preview-free",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "high"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid broad refactors and unnecessary context expansion."
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode/hy3-preview-free",
      "variant": "high"
    },
    "artistry": {
      "model": "opencode/ring-2.6-1t-free",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
      "variant": "high"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b"
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-high": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    },
    "git": {
      "model": "opencode/grok-code-fast-1"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 2,
      "nvidia": 4,
      "opencode": 10,
      "longcat": 20
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "kimi-for-coding/k2p6": 2,
      "opencode/gemini-3-flash": 1
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}