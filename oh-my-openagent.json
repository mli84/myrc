{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "kimi-for-coding/k2p6",
      "fallback_models": [
        {
          "model": "opencode/gemini-3.5-flash",
          "variant": "medium"
        },
        {
          "model": "longcat/LongCat-2.0-Preview"
        },
        {
          "model": "nvidia/deepseek-ai/deepseek-v4-pro",
          "variant": "medium"
        }
      ]
    },
    "metis": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "freemodel/claude-opus-4.8",
          "variant": "medium"
        },
        {
          "model": "freemodel/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "prometheus": {
      "model": "freemodel/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        {
          "model": "freemodel/claude-opus-4.8",
          "variant": "high"
        },
        {
          "model": "blazeai/qwen3.6-max-preview-thinking"
        }
      ]
    },
    "atlas": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "freemodel/claude-opus-4.7",
          "variant": "medium"
        },
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        }
      ]
    },
    "hephaestus": {
      "model": "opencode/gemini-3.5-flash",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode/gemini-3-flash"
        },
        {
          "model": "freemodel/gpt-5",
          "variant": "medium"
        }
      ]
    },
    "oracle": {
      "model": "freemodel/claude-opus-4.8",
      "variant": "high",
      "fallback_models": [
        {
          "model": "freemodel/claude-4.6",
          "variant": "medium"
        },
        {
          "model": "freemodel/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "momus": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        {
          "model": "freemodel/claude-haiku-4.5"
        },
        {
          "model": "blazeai/grok-4.20-fast"
        }
      ]
    },
    "explore": {
      "model": "opencode/qwen3.6-plus-free",
      "fallback_models": [
        {
          "model": "blazeai/qwen3.6-plus-search"
        },
        {
          "model": "blazeai/qwen3.5-omni-flash-search"
        }
      ]
    },
    "librarian": {
      "model": "opencode/nemotron-3-super-free",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "blazeai/qwen3.5-omni-plus-search"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        }
      ]
    },
    "multimodal-looker": {
      "model": "blazeai/qwen3.5-omni-plus-thinking"
    },
    "sisyphus-junior": {
      "model": "opencode/minimax-m3-free",
      "fallback_models": [
        {
          "model": "opencode/mimo-v2.5-free",
          "variant": "low"
        },
        {
          "model": "opencode/deepSeek-v4-flash-free",
          "variant": "low"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "blazeai/qwen3.5-omni-plus-thinking"
    },
    "artistry": {
      "model": "opencode/big-pickle"
    },
    "ultrabrain": {
      "model": "freemodel/claude-opus-4.8",
      "variant": "high"
    },
    "deep": {
      "model": "freemodel/gpt-5.5",
      "variant": "high"
    },
    "quick": {
      "model": "opencode/gemini-3.5-flash",
      "variant": "low"
    },
    "unspecified-high": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m3-free"
    },
    "writing": {
      "model": "freemodel/claude-opus-4.7",
      "variant": "medium"
    },
    "git": {
      "model": "kimi-for-coding/k2p6"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 1,
      "freemodel": 2,
      "nvidia": 4,
      "blazeai": 10,
      "opencode": 16,
      "longcat": 24
    },
    "modelConcurrency": {
      "opencode/gemini-3.5-flash": 1,
      "opencode/gemini-3-flash": 1
    }
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 5000,
    "source_url": "https://models.dev/api.json"
  },
  "experimental": {
    "truncate_all_tool_outputs": false,
    "aggressive_truncation": false,
    "auto_resume": false,
    "disable_omo_env": false,
    "task_system": true,
    "dynamic_context_pruning": {
      "enabled": false,
      "notification": "detailed",
      "turn_protection": {
        "enabled": true,
        "turns": 3
      },
      "protected_tools": [
        "task",
        "todowrite",
        "todoread",
        "lsp_rename",
        "session_read",
        "session_write",
        "session_search"
      ],
      "strategies": {
        "deduplication": {
          "enabled": true
        },
        "supersede_writes": {
          "enabled": true,
          "aggressive": false
        },
        "purge_errors": {
          "enabled": true,
          "turns": 5
        }
      }
    }
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}