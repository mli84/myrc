{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "Sisyphus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "max"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "Metis": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ],
      "prompt_append": "Break tasks into hierarchical steps. Optimize for minimal exploration depth and token usage."
    },
    "Prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Optimize concurrency, cost, and execution speed. Prefer cheap models first and avoid redundant calls."
    },
    "Atlas": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ],
      "prompt_append": "Return only highly relevant snippets, functions, and classes. Never summarize full files."
    },
    "Hephaestus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Prefer localized modifications and minimal diffs. Avoid broad refactors unless explicitly required."
    },
    "Oracle": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "Momus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, edge cases, and side effects. Reject uncertain fixes."
    },
    "Explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Thinking"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Focus on architecture, dependencies, state flow, and call chains. Expand context only when necessary."
    },
    "Librarian": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "opencode/gemini-3-flash"
        },
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ]
    },
    "Multimodal-Looker": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode/hy3-preview-free",
          "variant": "high"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        },
        {
          "model": "longcat/LongCat-2.0-Preview"
        }
      ]
    },
    "Sisyphus-Junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "low"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ],
      "prompt_append": "Handle only small localized edits and minimal diffs. Avoid refactors and unrelated context expansion."
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "high"
        }
      ]
    },
    "artistry": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "opencode/hy3-preview-free",
          "variant": "high"
        },
        {
          "model": "opencode/gemini-3-flash"
        }
      ]
    },
    "ultrabrain": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        }
      ]
    },
    "deep": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "max"
        }
      ]
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ]
    },
    "unspecified-high": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        }
      ]
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        }
      ]
    },
    "writing": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "opencode/gemini-3-flash"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "git": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ]
    }
  },
  "background_task": {
    "providerConcurrency": {
      "nvidia": 3,
      "opencode": 8,
      "longcat": 16
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "nvidia/qwen/qwen3.5-122b-a10b": 2,
      "nvidia/openai/gpt-oss-120b": 2
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
        "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
}
}