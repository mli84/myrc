{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "blazeai/moonshotai/kimi-k2.6",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/deepseek-ai/deepseek-v4-flash",
          "variant": "high"
        },
        {
          "model": "opencode/north-mini-code-free"
        }
      ]
    },
    "metis": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-ultra-free",
          "variant": "high"
        }
      ]
    },
    "prometheus": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
      "variant": "high",
      "fallback_models": [
        {
          "model": "longcat/LongCat-2.0-Preview"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "atlas": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "opencode/minimax-m3-free"
        }
      ]
    },
    "hephaestus": {
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "variant": "high",
      "fallback_models": [
        {
          "model": "blazeai/moonshotai/kimi-k2.6"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        }
      ]
    },
    "oracle": {
      "model": "blazeai/grok-4.20-fast",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "opencode/gemini-3.5-flash",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        {
          "model": "opencode/mimo-v2.5-free",
          "variant": "high"
        },
        {
          "model": "opencode/minimax-m3-free"
        }
      ]
    },
    "explore": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
          "model": "longcat/LongCat-2.0-Preview"
        },
        {
          "model": "opencode/gemini-3-flash"
        }
      ]
    },
    "librarian": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        },
        {
          "model": "opencode/gemini-3-flash"
        }
      ]
    },
    "multimodal-looker": {
      "model": "opencode/gemini-3.5-flash",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode/gemini-3-flash"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.7-flash",
          "variant": "high"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "nvidia/stepfun-ai/step-3.7-flash",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        },
        {
          "model": "opencode/mimo-v2.5-free",
          "variant": "medium"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode/gemini-3.5-flash",
      "variant": "high",
      "fallback_models": [
        {
          "model": "nvidia/stepfun-ai/step-3.7-flash",
          "variant": "high"
        }
      ]
    },
    "artistry": {
      "model": "blazeai/grok-4.20-fast",
      "fallback_models": [
        {
          "model": "opencode/big-pickle"
        }
      ]
    },
    "ultrabrain": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
      "variant": "high",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        }
      ]
    },
    "deep": {
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "variant": "max",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        }
      ]
    },
    "quick": {
      "model": "nvidia/stepfun-ai/step-3.5-flash",
      "variant": "low",
      "fallback_models": [
        {
          "model": "opencode/gemini-3-flash"
        }
      ]
    },
    "unspecified-high": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "longcat/LongCat-2.0-Preview"
        }
      ]
    },
    "unspecified-low": {
      "model": "nvidia/stepfun-ai/step-3.7-flash",
      "variant": "low",
      "fallback_models": [
        {
          "model": "opencode/mimo-v2.5-free",
          "variant": "low"
        }
      ]
    },
    "writing": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "opencode/minimax-m3-free"
        }
      ]
    },
    "git": {
      "model": "blazeai/moonshotai/kimi-k2.6",
      "fallback_models": [
        {
          "model": "opencode/north-mini-code-free"
        }
      ]
    },
    "general": {
      "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct",
      "fallback_models": [
        {
          "model": "opencode/nemotron-3-ultra-free",
          "variant": "medium"
        }
      ]
    }
  },
  "background_task": {
    "providerConcurrency": {
      "kimi-for-coding": 1,
      "freemodel": 1,
      "shared": 1,
      "nvidia": 4,
      "blazeai": 10,
      "opencode": 16,
      "longcat": 24
    },
    "modelConcurrency": {
      "kimi-for-coding/k2p6": 1,
      "opencode/gemini-3.5-flash": 1,
      "opencode/gemini-3-flash": 1
    }
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 5000,
    "source_url": "https://models.dev/api.json"
  },
  "experimental": {
    "truncate_all_tool_outputs": false,
    "aggressive_truncation": false,
    "auto_resume": false,
    "disable_omo_env": false,
    "task_system": true,
    "dynamic_context_pruning": {
      "enabled": false,
      "notification": "detailed",
      "turn_protection": {
        "enabled": true,
        "turns": 3
      },
      "protected_tools": [
        "task",
        "todowrite",
        "todoread",
        "lsp_rename",
        "session_read",
        "session_write",
        "session_search"
      ],
      "strategies": {
        "deduplication": {
          "enabled": true
        },
        "supersede_writes": {
          "enabled": true,
          "aggressive": false
        },
        "purge_errors": {
          "enabled": true,
          "turns": 5
        }
      }
    }
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}