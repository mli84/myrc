  },
  "background_task": {
    "providerConcurrency": {
      "nvidia": 4,
      "blazeai": 10,
      "opencode": 16,
      "longcat": 24
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "blazeai/qwen3.6-plus": 6,
      "blazeai/qwen3.6-plus-thinking": 4,
      "blazeai/qwen3.6-max-preview-thinking": 2,
      "opencode/gemini-3.5-flash": 4
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}