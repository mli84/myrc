{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "opencode/grok-code-fast-1"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/glm-4.7"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "metis": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "medium"
        },
        {
          "model": "opencode/big-pickle"
        }
      ],
      "prompt_append": "Break tasks into minimal executable steps. Prefer module to file to function exploration."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "low"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        }
      ],
      "prompt_append": "Optimize latency and cost. Parallelize Atlas and Explore when beneficial."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        }
      ],
      "prompt_append": "Return only highly relevant snippets, functions, classes, and symbols. Avoid summarizing entire files."
    },
    "hephaestus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/glm-4.7"
        },
        {
          "model": "opencode/grok-code-fast-1"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized edits and avoid unnecessary refactors."
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "max"
        }
      ]
    },
    "momus": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "opencode/glm-4.7"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, edge cases, regressions, and side effects."
    },
    "explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Thinking"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "high"
        }
      ],
      "prompt_append": "Use Atlas results first. Expand context only when necessary."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "medium"
        }
      ]
    },
    "multimodal-looker": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode/ring-2.6-1t-free",
          "variant": "high"
        },
        {
          "model": "opencode/hy3-preview-free",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/grok-code-fast-1"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid large refactors and unrelated modifications."
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "high"
    },
    "artistry": {
      "model": "opencode/hy3-preview-free",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
      "variant": "high"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b"
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-high": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    },
    "git": {
      "model": "opencode/grok-code-fast-1"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "nvidia": 4,
      "opencode": 12,
      "longcat": 20
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "nvidia/qwen/qwen3.5-122b-a10b": 2,
      "nvidia/openai/gpt-oss-120b": 3,
      "opencode/deepseek-v4-flash-free": 10
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
}
}