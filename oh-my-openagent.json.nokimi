{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ]
    },
    "metis": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3-next-80b-a3b-instruct"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "medium"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Break tasks into minimal hierarchical steps. Prefer module to file to function exploration. Minimize unnecessary file reads and token usage."
    },
    "prometheus": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/big-pickle"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "low"
        }
      ],
      "prompt_append": "Optimize for throughput and low latency. Parallelize Atlas and Explore aggressively. Prefer cheap models first. Stop exploration early when sufficient context is gathered."
    },
    "atlas": {
      "model": "longcat/LongCat-Flash-Lite",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Thinking"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ],
      "prompt_append": "Return only highly relevant snippets, functions, symbols, and definitions. Never summarize entire files. Keep outputs concise and structured."
    },
    "hephaestus": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "nvidia/qwen/qwen3.5-122b-a10b"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        }
      ],
      "prompt_append": "Minimize code changes. Prefer localized fixes over large refactors. Avoid touching unrelated files. Delegate small changes to sisyphus-junior."
    },
    "oracle": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b",
      "fallback_models": [
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "high"
        },
        {
          "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "variant": "high"
        },
        {
          "model": "opencode/nemotron-3-super-free",
          "variant": "high"
        }
      ]
    },
    "momus": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "longcat/LongCat-2.0-Preview"
        },
        {
          "model": "nvidia/openai/gpt-oss-120b",
          "variant": "medium"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "medium"
        }
      ],
      "prompt_append": "Strictly validate correctness, regressions, edge cases, concurrency issues, and side effects. Reject uncertain solutions."
    },
    "explore": {
      "model": "longcat/LongCat-2.0-Preview",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Thinking"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "high"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "medium"
        }
      ],
      "prompt_append": "Use Atlas output as primary context. Expand only when necessary. Focus on architecture, call chains, state flow, and dependencies."
    },
    "librarian": {
      "model": "opencode/gemini-3-flash",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/big-pickle"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ]
    },
    "multimodal-looker": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "max"
        },
        {
          "model": "longcat/LongCat-2.0-Preview"
        },
        {
          "model": "nvidia/stepfun-ai/step-3.5-flash",
          "variant": "high"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "longcat/LongCat-Flash-Thinking",
      "fallback_models": [
        {
          "model": "longcat/LongCat-Flash-Lite"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        },
        {
          "model": "opencode/deepseek-v4-flash-free",
          "variant": "low"
        }
      ],
      "prompt_append": "Handle only small localized edits. Avoid broad refactors. Prefer minimal diffs and limited context."
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "nvidia/openai/gpt-oss-120b",
      "variant": "high"
    },
    "artistry": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "ultrabrain": {
      "model": "nvidia/nvidia/nemotron-3-super-120b-a12b",
      "variant": "high"
    },
    "deep": {
      "model": "nvidia/qwen/qwen3.5-122b-a10b"
    },
    "quick": {
      "model": "longcat/LongCat-Flash-Lite"
    },
    "unspecified-high": {
      "model": "longcat/LongCat-2.0-Preview"
    },
    "unspecified-low": {
      "model": "opencode/minimax-m2.5-free"
    },
    "writing": {
      "model": "opencode/gemini-3-flash"
    },
    "git": {
      "model": "longcat/LongCat-Flash-Thinking"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "nvidia": 4,
      "opencode": 10,
      "longcat": 20
    },
    "modelConcurrency": {
      "longcat/LongCat-Flash-Lite": 40,
      "longcat/LongCat-Flash-Thinking": 16,
      "longcat/LongCat-2.0-Preview": 8,
      "nvidia/qwen/qwen3.5-122b-a10b": 3,
      "nvidia/openai/gpt-oss-120b": 3
    }
  },
  "experimental": {
    "task_system": true,
    "aggressive_truncation": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  }
}